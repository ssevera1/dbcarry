  "view_definitions": [
    {
      "schema": "public",
      "name": "recent_orders",
      "kind": "view",
      "definition": " SELECT o.id, c.email, o.status, o.ordered_at FROM (orders o JOIN customers c ON ((c.id = o.customer_id))) WHERE (o.ordered_at > (now() - '90 days'::interval));"
    },
    {
      "schema": "public",
      "name": "sales_by_product",
      "kind": "matview",
      "definition": " SELECT p.id, p.sku, sum(oi.quantity) AS qty, sum((oi.quantity * oi.unit_price_cents)) AS revenue_cents FROM (order_items oi JOIN products p ON ((p.id = oi.product_id))) GROUP BY p.id, p.sku;"
    }
  ],
